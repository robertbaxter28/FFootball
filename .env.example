# Anthropic API key — required for the chat agent
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your Sleeper username
SLEEPER_USERNAME=your_sleeper_username

# Your dynasty league ID (find it in the Sleeper app URL)
SLEEPER_LEAGUE_ID=your_league_id

# NFL season year (e.g. 2024)
SLEEPER_SEASON=2025

# Optional: override default DB path
# FFOOTBALL_DB_PATH=data/dynasty.db
